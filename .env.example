# Shared
PROJECT_NAME=mspintel
ENVIRONMENT=development
MSPINTEL_APP_VERSION=2.6.0

# Frontend
# For Docker Compose dev, leave unset or empty so the UI uses Vite's /api → backend proxy (see compose.yaml).
# For a direct browser→API setup, set e.g. http://localhost:8001
VITE_API_BASE_URL=http://localhost:8001
VITE_APP_VERSION=2.6.0
# When running the Vite dev server in Docker with a bind-mounted frontend, file-watch polling avoids stale UI (Compose sets CHOKIDAR_USEPOLLING for the frontend service). For local `npm run dev`, set only if you see HMR not updating: VITE_DEV_POLL=true

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# JSON array; do not set to [] — empty list removes all CORS origins (mitigated in code for development).
BACKEND_CORS_ORIGINS=["http://localhost:5173"]
DATABASE_URL=postgresql+psycopg://mspintel:mspintel@postgres:5432/mspintel
REDIS_URL=redis://redis:6379/0
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
# Tenant workspace JWT/session TTL (POST /auth/login, signup, tenant refresh)
TENANT_ACCESS_TOKEN_EXPIRE_MINUTES=30
TENANT_REFRESH_TOKEN_EXPIRE_DAYS=7
# Platform console JWT/session TTL (POST /auth/platform/login, platform refresh) — shorter by default
PLATFORM_ACCESS_TOKEN_EXPIRE_MINUTES=15
PLATFORM_REFRESH_TOKEN_EXPIRE_DAYS=3
# Platform operator MFA (TOTP). When true, platform admins without enabled TOTP get an enrolment-only token at login.
PLATFORM_MFA_REQUIRED=false
# Fernet key (44 url-safe base64 chars) for encrypting TOTP secrets at rest — MUST be set in production.
MFA_TOTP_ENCRYPTION_KEY=sEPh09o3P1QLJECURZ1PrQbVIv540e3eec0lgsBvxeA=
MFA_CHALLENGE_TTL_MINUTES=5
MFA_ENROLLMENT_SETUP_TTL_MINUTES=15
# HMAC pepper for platform MFA recovery codes (hashed at rest). Use a long random value in production (min 16 chars).
MFA_RECOVERY_CODE_PEPPER=dev-mfa-recovery-pepper-min-sixteen
# Platform login rate limiting (Redis). Set false for local tests without Redis counters.
PLATFORM_LOGIN_RATELIMIT_ENABLED=true
PLATFORM_LOGIN_PASSWORD_MAX_ATTEMPTS=30
PLATFORM_LOGIN_PASSWORD_WINDOW_SECONDS=900
PLATFORM_LOGIN_MFA_MAX_ATTEMPTS=40
PLATFORM_LOGIN_MFA_WINDOW_SECONDS=900
REQUIRE_TENANT_CONTEXT=false
INVITATION_TTL_HOURS=72
FRONTEND_APP_URL=http://localhost:5173
EXPOSE_INVITATION_TOKEN_IN_RESPONSE=false

# Mail (development via Mailpit)
MAIL_FROM_EMAIL=noreply@mspintel.local
MAIL_SMTP_HOST=mailpit
MAIL_SMTP_PORT=1025
MAIL_SMTP_USERNAME=
MAIL_SMTP_PASSWORD=
MAIL_USE_TLS=false

# AI + integration security
AI_PROVIDER_DEFAULT=openai
AI_PROVIDER_API_KEY=
INTEGRATION_ENCRYPTION_KEY=change-me

# Billing/provider placeholders
BILLING_PROVIDER=stripe
BILLING_PROVIDER_API_KEY=

# Seed users
SEED_PLATFORM_ADMIN_EMAIL=admin@mspintel.example.com
SEED_PLATFORM_ADMIN_PASSWORD=ChangeMe123!

# Worker
WORKER_POLL_SECONDS=5
