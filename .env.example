# Shared
PROJECT_NAME=mspintel
ENVIRONMENT=development
MSPINTEL_APP_VERSION=1.2

# Frontend
# For Docker Compose dev, leave unset or empty so the UI uses Vite's /api → backend proxy (see compose.yaml).
# For a direct browser→API setup, set e.g. http://localhost:8001
VITE_API_BASE_URL=http://localhost:8001
VITE_APP_VERSION=1.2

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# JSON array; do not set to [] — empty list removes all CORS origins (mitigated in code for development).
BACKEND_CORS_ORIGINS=["http://localhost:5173"]
DATABASE_URL=postgresql+psycopg://mspintel:mspintel@postgres:5432/mspintel
REDIS_URL=redis://redis:6379/0
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_MINUTES=10080
REQUIRE_TENANT_CONTEXT=false
INVITATION_TTL_HOURS=72
FRONTEND_APP_URL=http://localhost:5173
EXPOSE_INVITATION_TOKEN_IN_RESPONSE=false

# Mail (development via Mailpit)
MAIL_FROM_EMAIL=noreply@mspintel.local
MAIL_SMTP_HOST=mailpit
MAIL_SMTP_PORT=1025
MAIL_SMTP_USERNAME=
MAIL_SMTP_PASSWORD=
MAIL_USE_TLS=false

# AI + integration security
AI_PROVIDER_DEFAULT=openai
AI_PROVIDER_API_KEY=
INTEGRATION_ENCRYPTION_KEY=change-me

# Billing/provider placeholders
BILLING_PROVIDER=stripe
BILLING_PROVIDER_API_KEY=

# Seed users
SEED_PLATFORM_ADMIN_EMAIL=admin@mspintel.example.com
SEED_PLATFORM_ADMIN_PASSWORD=ChangeMe123!

# Worker
WORKER_POLL_SECONDS=5
