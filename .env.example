# Shared
PROJECT_NAME=mspintel
ENVIRONMENT=development

# Frontend
VITE_API_BASE_URL=http://localhost:8001

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=["http://localhost:5173"]
